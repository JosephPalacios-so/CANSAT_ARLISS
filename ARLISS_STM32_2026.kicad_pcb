	)
	(paper "A4")
	(layers
		(0 "F.Cu" signal "F.Cu (TOP)")
		(4 "In1.Cu" power "GND")
		(6 "In2.Cu" power "Power")
		(2 "B.Cu" signal "B.Cu (BOTTOM)")
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
		(5 "F.SilkS" user "F.Silkscreen")
		(7 "B.SilkS" user "B.Silkscreen")
